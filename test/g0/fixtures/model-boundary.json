      "input": { "claims": [{ "kind": "topic", "subjectCandidate": "contract validation", "evidenceIds": ["evd_1"] }], "relationCandidates": [{ "kind": "related_to", "evidenceIds": ["evd_1"], "explanation": "Both discuss contract validation." }] },
      "expected": { "decision": "allow", "numericFieldsAccepted": false, "authorityGranted": false }
